<?xml version="1.0" encoding="utf-8"?>
<!--
  Configurazione dell'artefatto da incollare in SignPath:
  Project "pdfpaper" > Artifact configurations > Edit.
  L'artefatto è lo zip creato da GitHub Actions con il contenuto di dist\PdfPaper.
  Viene firmato solo PdfPaper.exe (codice nostro); le librerie in lib\ restano quelle originali.
  product-name e product-version devono coincidere con version_info.txt (requisito SignPath).
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="PdfPaper.exe" product-name="PdfPaper" product-version="1.0.0.0">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
