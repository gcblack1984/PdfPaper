<?xml version="1.0" encoding="utf-8"?>
<!--
  Descrizione del pacchetto MSIX di PdfPaper per Microsoft Store.
  I valori tra doppi trattini bassi vengono sostituiti da GitHub Actions (build.yml):
    __IDENTITY_NAME__      Partner Center > Gestione prodotti > Identità prodotto > Package/Identity/Name
    __PUBLISHER__          Partner Center > ... > Package/Identity/Publisher        (es. CN=1A2B3C4D-...)
    __PUBLISHER_DISPLAY__  Partner Center > ... > Package/Properties/PublisherDisplayName
    __VERSION__            da version_info.txt (es. 1.1.0.0)
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity Name="__IDENTITY_NAME__"
            Publisher="__PUBLISHER__"
            Version="__VERSION__"
            ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>PdfPaper</DisplayName>
    <PublisherDisplayName>__PUBLISHER_DISPLAY__</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="it-IT" />
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="PdfPaper" Executable="PdfPaper.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="PdfPaper"
        Description="Editor PDF: OCR, modifica del testo, immagini, pagine, compressione e omissis"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" Square71x71Logo="Assets\Square71x71Logo.png"
                         ShortName="PdfPaper" />
      </uap:VisualElements>
      <Extensions>
        <!-- compare in "Apri con" per i file PDF -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="pdf">
            <uap:DisplayName>Documento PDF</uap:DisplayName>
            <uap:Logo>Assets\Square44x44Logo.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType ContentType="application/pdf">.pdf</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
